{
  "name": "tokenscope-showcase",
  "version": "1.0.0",
  "description": "Programmatic 190-second terminal video showcase for TokenScope using Remotion",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts TokenScopeShowcase out/tokenscope-showcase-190s.mp4",
    "render-preview": "remotion render src/index.ts TokenScopeShowcase out/preview.mp4 --scale=0.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.218"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.218",
    "@types/react": "^18.3.3",
    "typescript": "^5.4.5"
  }
}
